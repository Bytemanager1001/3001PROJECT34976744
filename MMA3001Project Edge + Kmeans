arlos Wu","userId":"08686839612060652923"}},"outputId":"32946324-0b62-4466-dc07-c2c3c559e123"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Copied: /content/drive/MyDrive/Colab Notebooks/3001/train/_annotations.csv\n","     To: /content/drive/MyDrive/Colab Notebooks/3001/trainprocessed/_annotations.csv\n","\n","Copied: /content/drive/MyDrive/Colab Notebooks/3001/valid/_annotations.csv\n","     To: /content/drive/MyDrive/Colab Notebooks/3001/validprocessed/_annotations.csv\n","\n","Copied: /content/drive/MyDrive/Colab Notebooks/3001/test/_annotations.csv\n","     To: /content/drive/MyDrive/Colab Notebooks/3001/testprocessed/_annotations.csv\n","\n","CSV copying complete.\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# YOLO CLASS CONFIGURATION\n","# =============================================================\n","\n","CLASS_NAMES = [\n","    \"loose meat\",\n","    \"twisted meat\",\n","    \"unsealed packaging\",\n","    \"wrinkled meat\"\n","]\n","\n","CLASS_ALIASES = {\n","    \"loose meat\": 0,\n","    \"loose_meat\": 0,\n","    \"loose-meat\": 0,\n","    \"loose\": 0,\n","\n","    \"twisted meat\": 1,\n","    \"twisted_meat\": 1,\n","    \"twisted-meat\": 1,\n","    \"twisted\": 1,\n","\n","    \"unsealed\": 2,\n","    \"unsealed packaging\": 2,\n","    \"unsealed_packaging\": 2,\n","    \"packaging-error\": 2,\n","\n","    \"wrinkled meat\": 3,\n","    \"wrinkled_meat\": 3,\n","    \"wrinkle\": 3,\n","    \"wrinkled\": 3\n","}\n","\n","\n","def normalise_class(value):\n","    \"\"\"Standardise class names for matching.\"\"\"\n","    return \" \".join(str(value).strip().lower().replace(\"_\", \" \").replace(\"-\", \" \").split())\n","\n","\n","NORMALISED_ALIASES = {\n","    normalise_class(name): class_id\n","    for name, class_id in CLASS_ALIASES.items()\n","}\n","\n","\n","# ============================================================\n","# FIND THE CSV FILE\n","# ============================================================\n","\n","def find_csv(folder):\n","    csv_files = list(folder.glob(\"*.csv\"))\n","\n","    if len(csv_files) != 1:\n","        raise ValueError(\n","            f\"Expected exactly one CSV in {folder}, \"\n","            f\"but found {len(csv_files)}: \"\n","            f\"{[p.name for p in csv_files]}\"\n","        )\n","\n","    return csv_files[0]\n","\n","\n","# ============================================================\n","# CONVERT ONE SPLIT TO YOLO FORMAT\n","# ============================================================\n","\n","def convert_split(source_folder, segmented_folder, split_name):\n","\n","    csv_path = find_csv(source_folder)\n","    df = pd.read_csv(csv_path)\n","\n","    required_columns = {\n","        \"filename\", \"width\", \"height\",\n","        \"class\", \"xmin\", \"ymin\", \"xmax\", \"ymax\"\n","    }\n","\n","    missing_columns = required_columns - set(df.columns)\n","\n","    if missing_columns:\n","        raise ValueError(\n","            f\"Missing columns in {csv_path}: {missing_columns}\"\n","        )\n","\n","    # Index segmented images by filename.\n","    # This allows annotations to match images by basename.\n","    image_lookup = {}\n","\n","    for image_path in segmented_folder.rglob(\"*\"):\n","        if image_path.is_file() and image_path.suffix.lower() in {\n","            \".jpg\", \".jpeg\", \".png\"\n","        }:\n","            key = image_path.name.lower()\n","\n","            if key in image_lookup:\n","                raise ValueError(\n","                    f\"Duplicate image basename in {segmented_folder}: \"\n","                    f\"{image_path.name}\"\n","                )\n","\n","            image_lookup[key] = image_path\n","\n","    images_output = YOLO_DATASET / \"images\" / split_name\n","    labels_output = YOLO_DATASET / \"labels\" / split_name\n","\n","    images_output.mkdir(parents=True, exist_ok=True)\n","    labels_output.mkdir(parents=True, exist_ok=True)\n","\n","    # Group annotations by source filename\n","    df[\"source_basename\"] = df[\"filename\"].astype(str).map(\n","        lambda x: Path(x.strip()).name.lower()\n","    )\n","\n","    unknown_classes = sorted({\n","        normalise_class(value)\n","        for value in df[\"class\"].dropna().unique()\n","        if normalise_class(value) not in NORMALISED_ALIASES\n","    })\n","\n","    if unknown_classes:\n","        raise ValueError(\n","            f\"Unmapped classes in {csv_path}: {unknown_classes}. \"\n","            \"Add these names to CLASS_ALIASES before continuing.\"\n","        )\n","\n","    copied_images = 0\n","    missing_images = []\n","    invalid_boxes = 0\n","\n","    for filename, rows in df.groupby(\"source_basename\", sort=False):\n","\n","        segmented_path = image_lookup.get(filename)\n","\n","        if segmented_path is None:\n","            missing_images.append(filename)\n","            continue\n","\n","        # Verify image can be read\n","        image = cv2.imread(str(segmented_path))\n","\n","        if image is None:\n","            print(f\"Skipping unreadable image: {segmented_path}\")\n","            continue\n","\n","        actual_height, actual_width = image.shape[:2]\n","\n","        # Copy segmented image into the YOLO dataset.\n","        # Prefix the filename with split name to prevent collisions.\n","        output_filename = f\"{split_name}_{segmented_path.stem}.jpg\"\n","        output_image_path = images_output / output_filename\n","\n","        if not cv2.imwrite(str(output_image_path), image):\n","            print(f\"Failed to write image: {output_image_path}\")\n","            continue\n","\n","        label_lines = []\n","\n","        for _, row in rows.iterrows():\n","\n","            class_id = NORMALISED_ALIASES[\n","                normalise_class(row[\"class\"])\n","            ]\n","\n","            # Use the CSV's image dimensions to normalise its boxes.\n","            csv_width = float(row[\"width\"])\n","            csv_height = float(row[\"height\"])\n","\n","            if csv_width <= 0 or csv_height <= 0:\n","                invalid_boxes += 1\n","                continue\n","\n","            xmin = float(row[\"xmin\"])\n","            ymin = float(row[\"ymin\"])\n","            xmax = float(row[\"xmax\"])\n","            ymax = float(row[\"ymax\"])\n","\n","            # Convert to normalised YOLO coordinates\n","            x_center = ((xmin + xmax) / 2) / csv_width\n","            y_center = ((ymin + ymax) / 2) / csv_height\n","            box_width = (xmax - xmin) / csv_width\n","            box_height = (ymax - ymin) / csv_height\n","\n","            if (\n","                box_width <= 0 or box_height <= 0\n","                or xmin < 0 or ymin < 0\n","                or xmax > csv_width or ymax > csv_height\n","            ):\n","                invalid_boxes += 1\n","                continue\n","\n","            # Ensure image dimensions and CSV dimensions agree.\n","            # The preprocessing should preserve image dimensions.\n","            if (\n","                int(round(csv_width)) != actual_width\n","                or int(round(csv_height)) != actual_height\n","            ):\n","                raise ValueError(\n","                    f\"Dimension mismatch for {filename}: \"\n","                    f\"CSV={csv_width}x{csv_height}, \"\n","                    f\"processed image={actual_width}x{actual_height}\"\n","                )\n","\n","            label_lines.append(\n","                f\"{class_id} \"\n","                f\"{x_center:.6f} {y_center:.6f} \"\n","                f\"{box_width:.6f} {box_height:.6f}\"\n","            )\n","\n","        label_path = labels_output / f\"{Path(output_filename).stem}.txt\"\n","        label_path.write_text(\n","            \"\\n\".join(label_lines) + (\"\\n\" if label_lines else \"\"),\n","            encoding=\"utf-8\"\n","        )\n","\n"